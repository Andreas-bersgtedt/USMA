# Azure Service Principal (used by azure-identity EnvironmentCredential)
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=

# Target subscription / Synapse workspace
AZURE_SUBSCRIPTION_ID=
SYNAPSE_RESOURCE_GROUP=
SYNAPSE_WORKSPACE_NAME=

# Optional: limit to a single dedicated SQL pool (default: all)
SYNAPSE_DEDICATED_POOL=

# SQL connection (pyodbc). Leave default unless you need to override.
SQL_ODBC_DRIVER=ODBC Driver 18 for SQL Server
SQL_LOGIN_TIMEOUT=30
SQL_QUERY_TIMEOUT=120

# Output
SMA_OUTPUT_DIR=./output

# --- Source-type override (Phase 4) -----------------------------------
# Default: synapse. Options: synapse | adf | databricks | bigquery
# SMA_SOURCE_TYPE=databricks

# --- Google BigQuery (Phase 4-D, alpha) -------------------------------
# Required when SMA_SOURCE_TYPE=bigquery. ADC-based; AZURE_* vars ignored.
# SMA_GCP_PROJECT_ID=my-gcp-project
# GOOGLE_APPLICATION_CREDENTIALS=C:\path\to\sa-key.json

# --- Databricks on AWS (Phase 4.7, alpha) -----------------------------
# Setting SMA_DATABRICKS_PLATFORM=aws swaps the Azure ARM-backed provider
# for DatabricksAwsProvider. The four AZURE_* SP vars above are ignored
# in this mode. See docs/user-guide/21a-databricks-aws.md.
# SMA_DATABRICKS_PLATFORM=aws
#
# Single-workspace mode (no account-level discovery):
# DATABRICKS_HOST=https://dbc-abc12345-6789.cloud.databricks.com
# DATABRICKS_TOKEN=dapi...               # PAT (simplest), OR
# DATABRICKS_CLIENT_ID=...                # workspace SP OAuth M2M
# DATABRICKS_CLIENT_SECRET=...
#
# Account-API discovery (enumerates every workspace under the account):
# DATABRICKS_ACCOUNT_ID=1234abcd-...
# DATABRICKS_ACCOUNT_CLIENT_ID=...
# DATABRICKS_ACCOUNT_CLIENT_SECRET=...
